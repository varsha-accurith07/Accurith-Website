// Prisma schema — see https://pris.ly/d/prisma-schema
//
// Four tables. Deliberately boring. We are a five-enquiries-a-week prototype
// and I read records via Railway's Postgres dashboard — no admin UI here.
//
// Personal data lives in this schema. Retention, right-to-erasure, and
// residency policies are open items — see CLAUDE.md §Privacy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Consultation — a "Book a consultation" enquiry from the marketing site.
model Consultation {
  id        String              @id @default(cuid())
  createdAt DateTime            @default(now())

  name    String
  email   String
  company String
  role    String
  service String
  message String              @db.Text

  status  ConsultationStatus  @default(NEW)

  @@index([email])
  @@index([createdAt])
}

enum ConsultationStatus {
  NEW
  CONTACTED
  CLOSED
}

// JobOpening — powers the /careers page. Varsha's page reads this via
// GET /api/careers/openings. I add/edit openings via Railway's Postgres
// dashboard (or `npx prisma studio` locally).
model JobOpening {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  department     String
  location       String
  employmentType String
  descriptionMd  String       @db.Text
  isOpen         Boolean      @default(true)
  postedAt       DateTime     @default(now())

  applications   JobApplication[]

  @@index([isOpen, postedAt])
}

// JobApplication — a submission to one of the JobOpenings. Applicants give a
// LinkedIn / Drive / portfolio URL. We do NOT accept file uploads in this
// phase: an endpoint that takes arbitrary binaries from strangers is the
// first thing a buyer's pentest flags, and this is a cyber-security firm.
model JobApplication {
  id           String              @id @default(cuid())
  createdAt    DateTime            @default(now())

  openingId    String
  opening      JobOpening          @relation(fields: [openingId], references: [id], onDelete: Restrict)

  name         String
  email        String
  phone        String
  linkedinUrl  String
  portfolioUrl String?
  coverNote    String              @db.Text

  status       ApplicationStatus   @default(NEW)

  @@index([email])
  @@index([createdAt])
  @@index([openingId, status])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  REJECTED
  HIRED
}

// EarlyAccessRequest — the Products page waitlist. Products are "Launching
// soon", so this is a list of people to write to when they open, not a
// purchase intent. `product` is a free-text label rather than a relation:
// the product line is not settled and a table of two rows would be premature.
//
// Deliberately narrower than Consultation — name, email and which product.
// We promised on the form that we would write about nothing else, so we
// collect nothing else.
model EarlyAccessRequest {
  id        String                @id @default(cuid())
  createdAt DateTime              @default(now())

  name    String
  email   String
  product String

  status  EarlyAccessStatus     @default(NEW)

  // One person may register interest in more than one product, but not twice
  // for the same one.
  @@unique([email, product])
  @@index([createdAt])
}

enum EarlyAccessStatus {
  NEW
  INVITED
  CLOSED
}
